<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ currentReading.code }} {{ currentReading.title }}阅读笔记" />
    <meta name="theme-color" content="#f4f5f6" />
    <title>{{ pageTitle }}</title>
    <link rel="icon" href="{{ basePath }}favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="{{ basePath }}styles.css" />
    <script src="{{ basePath }}script.js" defer></script>
  </head>
  <body class="note-page">
    <a class="skip-link" href="#note-content">跳到笔记正文</a>
    <div class="ambient ambient-a" aria-hidden="true"></div>

    <header class="site-header">
      <a class="wordmark" href="{{ basePath }}index.html">
        <span class="wordmark-mark" aria-hidden="true">K</span>
        <span>Kaiyee's Study Archive</span>
      </a>
      <nav aria-label="笔记导航">
        <a href="{{ basePath }}notes/{{ currentTask.id }}/">Task {{ currentTask.number }}</a>
        <a href="{{ site.courseRepository }}" target="_blank" rel="noreferrer">课程仓库 <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main class="note-layout" id="note-content">
      {% include "_task-rail.njk" %}

      <article class="note-article reveal">
        <header class="note-title">
          <p>{{ currentReading.code }} · {{ currentReading.track }} · READING NOTE</p>
          <h1>{{ currentReading.title }}</h1>
          {% if currentReading.note.meta.summary %}<p class="note-deck">{{ currentReading.note.meta.summary }}</p>{% endif %}
          <dl class="note-facts" aria-label="笔记信息">
            <div><dt>所属任务</dt><dd>Task {{ currentTask.number }}</dd></div>
            <div><dt>日期</dt><dd>{{ currentReading.learningDate or "未记录" }}</dd></div>
            <div><dt>学习时长</dt><dd>{{ currentReading.durationMinutes + " 分钟" if currentReading.durationMinutes else "未记录" }}</dd></div>
          </dl>
        </header>

        <section class="reading-source" aria-labelledby="source-title">
          <p class="section-index">SOURCE</p>
          <div>
            <h2 id="source-title">原阅读文章</h2>
            <a href="{{ currentReading.sourceUrl }}" target="_blank" rel="noreferrer">
              <span>{{ currentReading.code }}：{{ currentReading.title }}</span>
              <b aria-hidden="true">↗</b>
            </a>
          </div>
        </section>

        <div class="note-body">
          {{ contentHtml | safe }}
        </div>

        <footer class="note-footer">
          <a href="{{ site.courseRepository }}" target="_blank" rel="noreferrer">查看课程仓库 <span aria-hidden="true">↗</span></a>
          <a href="{{ basePath }}notes/{{ currentTask.id }}/">返回 Task {{ currentTask.number }}</a>
        </footer>
      </article>
    </main>
  </body>
</html>

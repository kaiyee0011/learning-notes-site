<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ site.description }}" />
    <meta name="theme-color" content="#f4f5f6" />
    <title>{{ site.title }} · Kaiyee</title>
    <link rel="icon" href="{{ basePath }}favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="{{ basePath }}styles.css" />
    <script src="{{ basePath }}script.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#learning-log">跳到学习进度</a>
    <div class="ambient ambient-a" aria-hidden="true"></div>
    <div class="ambient ambient-b" aria-hidden="true"></div>

    <header class="site-header" id="top">
      <a class="wordmark" href="#top" aria-label="返回首页顶部">
        <span class="wordmark-mark" aria-hidden="true">K</span>
        <span>Kaiyee's Study Archive</span>
      </a>
      <nav aria-label="主要导航">
        <a href="#learning-log">学习进度</a>
        {% if latestTask %}<a href="./notes/{{ latestTask.id }}/">当前笔记</a>{% endif %}
        <a href="{{ site.courseRepository }}" target="_blank" rel="noreferrer">课程仓库 <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main>
      <section class="course-intro reveal" aria-labelledby="page-title">
        <div>
          <p class="eyebrow">LEARNING IN PUBLIC · 2026</p>
          <h1 id="page-title">EASY DATA × AI · TASK LOG</h1>
          <p class="course-deck">每个 Task 包含一篇任务笔记，以及对应的产品、开发者或产业应用阅读笔记。</p>
          <p class="course-source"><a href="{{ site.courseRepository }}" target="_blank" rel="noreferrer">学习内容来自 Datawhale 与 OceanBase 社区联合共建的《Easy Data x AI》。本站用于整理个人任务笔记与阅读随笔，感谢项目维护者与所有开源贡献者。↗</a></p>
        </div>
        <div class="course-progress" aria-label="课程学习进度 {{ completedTasks }}/{{ totalTasks }}">
          <div><span>已完成 Task</span><strong>{{ completedTasks | pad2 }} / {{ totalTasks | pad2 }}</strong></div>
          <div class="progress-line"><span style="width: {{ progressPercent }}%"></span></div>
        </div>
      </section>

      <section class="log-section" id="learning-log" aria-labelledby="log-title">
        <h2 class="sr-only" id="log-title">完整学习进度</h2>

        <div class="table-toolbar reveal">
          <label class="search-field">
            <span class="sr-only">搜索学习任务</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
            <input id="log-search" type="search" placeholder="搜索 Task、文章或任务要求" autocomplete="off" />
          </label>
          <span class="record-count" aria-live="polite"><b id="visible-count">{{ totalTasks }}</b> 个 Task</span>
        </div>

        <div class="table-shell reveal">
          <table>
            <caption class="sr-only">Task 0 至 Task 9 的学习进度</caption>
            <thead>
              <tr>
                <th scope="col">Task</th>
                <th scope="col">计划</th>
                <th scope="col">学习记录</th>
                <th scope="col">难度</th>
                <th scope="col">任务与阅读笔记</th>
              </tr>
            </thead>
            <tbody id="log-body">
              {% for task in tasks %}
                <tr class="{% if not task.note %}locked{% endif %}" data-search="{{ task.searchText }}">
                  <td data-label="Task">
                    <span class="chapter-code">TASK {{ task.number }}</span>
                    <strong class="task-name">{{ task.title }}</strong>
                  </td>
                  <td data-label="计划">
                    <div class="plan-cell {% if task.number == 0 %}personal-plan{% endif %}">
                      <strong>{{ task.durationDisplay }}</strong>
                      <span>{% if task.deadline %}截止 {% endif %}{{ task.deadlineCompact }}</span>
                    </div>
                  </td>
                  <td data-label="学习记录">
                    {% if task.note %}
                      <time datetime="{{ task.note.meta.date }}">{{ task.learningDate or "日期未记录" }}</time>
                      {% if task.durationMinutes %}
                        <span>{{ task.durationMinutes }} 分钟</span>
                      {% else %}
                        <span class="unrecorded">时长未记录</span>
                      {% endif %}
                      <span>{{ task.wordCountDisplay }} 字</span>
                    {% else %}
                      <span class="unrecorded">未记录</span>
                    {% endif %}
                  </td>
                  <td data-label="难度">
                    {% if task.difficulty %}
                      <span class="difficulty" aria-label="难度 {{ task.difficulty }} 星">
                        <span aria-hidden="true">
                          {% for _ in task.difficultyFilled %}<i></i>{% endfor %}
                          {% for _ in task.difficultyEmpty %}<b></b>{% endfor %}
                        </span>
                        {{ task.difficulty }}/5
                      </span>
                    {% else %}
                      <span class="unrecorded">待评价</span>
                    {% endif %}
                  </td>
                  <td data-label="笔记入口">
                    <div class="note-entry-stack">
                      {% if task.note %}
                        <a class="entry-link task-note-link" href="./notes/{{ task.id }}/"><span>任务笔记</span><b aria-hidden="true">↗</b></a>
                      {% else %}
                        <span class="entry-link locked-entry" aria-label="任务笔记尚未公开">
                          <span>任务笔记</span>
                          <svg class="lock-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="2"></rect><path d="M5.25 7V5.25a2.75 2.75 0 0 1 5.5 0V7"></path></svg>
                        </span>
                      {% endif %}
                      <div class="reading-links" aria-label="Task {{ task.number }} 的阅读笔记">
                        {% for reading in task.readings %}
                          {% if reading.note %}
                            <a class="entry-link" href="./readings/{{ reading.code }}/">
                              <span><b>{{ reading.code }}：</b>{{ reading.title }}</span>
                              <i aria-hidden="true">↗</i>
                            </a>
                          {% else %}
                            <span class="entry-link locked-entry" aria-label="{{ reading.code }}：{{ reading.title }}，笔记尚未公开">
                              <span><b>{{ reading.code }}：</b>{{ reading.title }}</span>
                              <svg class="lock-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="2"></rect><path d="M5.25 7V5.25a2.75 2.75 0 0 1 5.5 0V7"></path></svg>
                            </span>
                          {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
          <p class="empty-state" id="empty-state" hidden>没有匹配的学习任务。</p>
        </div>
      </section>
    </main>

    <footer>
      <p>个人学习记录 · 课程内容版权归原作者与贡献者所有。</p>
      <a href="{{ site.siteRepository }}" target="_blank" rel="noreferrer">查看网站源码 ↗</a>
    </footer>
  </body>
</html>

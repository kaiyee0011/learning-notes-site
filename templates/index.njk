<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ site.description }}" />
    <meta name="theme-color" content="#f4f5f6" />
    <title>{{ site.title }} · Kaiyee</title>
    <link rel="icon" href="{{ basePath }}favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="{{ basePath }}styles.css" />
    <script src="{{ basePath }}script.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#learning-log">跳到学习进度</a>
    <div class="ambient ambient-a" aria-hidden="true"></div>
    <div class="ambient ambient-b" aria-hidden="true"></div>

    <header class="site-header" id="top">
      <a class="wordmark" href="#top" aria-label="返回首页顶部">
        <span class="wordmark-mark" aria-hidden="true">K</span>
        <span>Study Archive</span>
      </a>
      <nav aria-label="主要导航">
        <a href="#learning-log">学习进度</a>
        {% if latestTask %}<a href="./notes/{{ latestTask.id }}/">当前笔记</a>{% endif %}
        <a href="{{ site.courseRepository }}" target="_blank" rel="noreferrer">课程仓库 <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main>
      <section class="course-intro reveal" aria-labelledby="page-title">
        <div>
          <p class="eyebrow">EASY DATA × AI · TASK LOG</p>
          <h1 id="page-title">学习任务与进度</h1>
          <p>每个 Task 包含一篇任务笔记，以及对应的产品、开发者或产业应用阅读笔记。</p>
        </div>
        <div class="course-progress" aria-label="课程学习进度 {{ completedTasks }}/{{ totalTasks }}">
          <div><span>已完成 Task</span><strong>{{ completedTasks | pad2 }} / {{ totalTasks | pad2 }}</strong></div>
          <div class="progress-line"><span style="width: {{ progressPercent }}%"></span></div>
          <p>进度以学习活动飞书表格为准。</p>
        </div>
      </section>

      <aside class="course-credit reveal" aria-label="进度来源与课程致谢">
        <span class="credit-mark" aria-hidden="true">↗</span>
        <p>
          学习安排以
          <a href="{{ site.progressSource }}" target="_blank" rel="noreferrer">飞书 Task 进度表</a>
          为唯一依据；阅读内容来自 Datawhale 与 OceanBase 社区联合共建的
          <a href="{{ site.courseRepository }}" target="_blank" rel="noreferrer">《Easy Data x AI》</a>。
          感谢项目维护者与所有开源贡献者。
        </p>
      </aside>

      <section class="log-section" id="learning-log" aria-labelledby="log-title">
        <header class="section-header reveal">
          <div>
            <p class="eyebrow">TASK 1—9</p>
            <h2 id="log-title">完整学习进度</h2>
          </div>
          <p>Markdown 文件存在且取消草稿状态后，相应入口自动解锁。</p>
        </header>

        <div class="table-toolbar reveal">
          <label class="search-field">
            <span class="sr-only">搜索学习任务</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
            <input id="log-search" type="search" placeholder="搜索 Task、文章或任务要求" autocomplete="off" />
          </label>
          <span class="record-count" aria-live="polite"><b id="visible-count">{{ totalTasks }}</b> 个 Task</span>
        </div>

        <div class="table-shell reveal">
          <table>
            <caption class="sr-only">飞书学习活动 Task 1 至 Task 9 的学习进度</caption>
            <thead>
              <tr>
                <th scope="col">Task</th>
                <th scope="col">计划</th>
                <th scope="col">学习记录</th>
                <th scope="col">难度</th>
                <th scope="col">任务与阅读笔记</th>
              </tr>
            </thead>
            <tbody id="log-body">
              {% for task in tasks %}
                <tr class="{% if not task.note %}locked{% endif %}" data-search="{{ task.searchText }}">
                  <td data-label="Task">
                    <span class="chapter-code">TASK {{ task.number }}</span>
                    <strong class="task-name">{{ task.title }}</strong>
                  </td>
                  <td data-label="计划">
                    <strong>{{ task.durationDays }} 天</strong>
                    <span>截止 {{ task.deadlineDisplay }}</span>
                  </td>
                  <td data-label="学习记录">
                    {% if task.note %}
                      <time datetime="{{ task.note.meta.date }}">{{ task.learningDate or "日期未记录" }}</time>
                      <span>{{ task.durationMinutes + " 分钟" if task.durationMinutes else "时长未记录" }}</span>
                    {% else %}
                      <span class="unrecorded">未记录</span>
                    {% endif %}
                  </td>
                  <td data-label="难度">
                    {% if task.difficulty %}
                      <span class="difficulty" aria-label="难度 {{ task.difficulty }} 星">
                        <span aria-hidden="true">
                          {% for _ in task.difficultyFilled %}<i></i>{% endfor %}
                          {% for _ in task.difficultyEmpty %}<b></b>{% endfor %}
                        </span>
                        {{ task.difficulty }}/5
                      </span>
                    {% else %}
                      <span class="unrecorded">待评价</span>
                    {% endif %}
                  </td>
                  <td data-label="笔记入口">
                    <div class="note-entry-stack">
                      {% if task.note %}
                        <a class="note-link task-note-link" href="./notes/{{ task.id }}/">任务笔记 <span aria-hidden="true">↗</span></a>
                      {% else %}
                        <span class="locked-entry">任务笔记 · 未解锁</span>
                      {% endif %}
                      <div class="reading-links" aria-label="Task {{ task.number }} 阅读笔记">
                        {% for reading in task.readings %}
                          {% if reading.note %}
                            <a href="./readings/{{ reading.code }}/" title="{{ reading.title }}">{{ reading.code }}</a>
                          {% else %}
                            <span title="{{ reading.track }}：{{ reading.title }}">{{ reading.code }} · 未解锁</span>
                          {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
          <p class="empty-state" id="empty-state" hidden>没有匹配的学习任务。</p>
        </div>
      </section>
    </main>

    <footer>
      <p>个人学习记录 · 进度来自飞书活动表，课程内容版权归原作者与贡献者所有。</p>
      <a href="{{ site.siteRepository }}" target="_blank" rel="noreferrer">查看网站源码 ↗</a>
    </footer>
  </body>
</html>
